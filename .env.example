# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"
MONGO_URI="mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority"
MONGO_DB_NAME="traininglobe_lead_nurturing"

# Authentication & Security
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# Initial Super Admin Account
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="replace-with-a-strong-password"
SUPERADMIN_NAME="Super Admin"

# Zoho Integration (OAuth 2.0)
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REFRESH_TOKEN=""
ZOHO_AUTH_URL="https://accounts.zoho.com"
ZOHO_API_DOMAIN="https://www.zohoapis.com"
ZOHO_FROM_EMAIL="admin@example.com"
ZOHO_DRY_RUN="true"

# LLM Configuration (Options: groq, gemini, openai, mock)
LLM_PROVIDER="mock"
LLM_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Automation & Safety Rules
DEFAULT_SEND_TIME="18:00"
TIMEZONE="Asia/Kolkata"
BUSINESS_HOURS_START="9"
BUSINESS_HOURS_END="19"
DAILY_SEND_LIMIT="100"
MAX_FOLLOWUPS="3"

# Legacy Next.js compatibility
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
ENCRYPTION_KEY="replace-with-a-32-byte-hex-key"
