DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Public base URL. Open/click tracking pixels and unsubscribe links point here,
# so if you deploy or expose via a tunnel, change this to the public URL.
APP_URL="http://localhost:3000"

# Session signing key and at-rest encryption key for Gmail app passwords.
AUTH_SECRET="REDACTED"
ENCRYPTION_KEY="REDACTED"

# Groq API keys. Comma-separated; the client rotates across them and fails over
# on rate limits, which matters because the cascade makes several calls per mail.
GROQ_API_KEYS="REDACTED"

# Reasoning/writing model, and the web-search-enabled model used for verification.
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_SEARCH_MODEL="groq/compound-mini"

# Gemini fallback. Used when a prompt is too large for Groq's per-model budget,
# or when Groq exhausts its retries on rate limits. Never used for the web-search
# agents, because google_search grounding is quota-blocked on this key.
GEMINI_API_KEY="REDACTED"
GEMINI_MODEL="gemini-flash-latest"

# Seed credentials for the first admin account (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="atharv.kumar@webisdom.com"
SEED_ADMIN_PASSWORD="ChangeMe@123"
SEED_ADMIN_NAME="Atharv Kumar"

# Background worker cadence
WORKER_POLL_CRON="*/5 * * * *"
WORKER_FOLLOWUP_CRON="*/10 * * * *"N="*/5 * * * *"
WORKER_FOLLOWUP_CRON="*/10 * * * *"