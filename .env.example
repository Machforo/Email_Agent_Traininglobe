# Copy to .env and fill in. Never commit the real .env.
# Requires Node.js ^20.19 || ^22.12 || >=24 (see .nvmrc).
# Generate the two secrets with:
#   node -e "const c=require('crypto');console.log('AUTH_SECRET='+c.randomBytes(48).toString('base64url'));console.log('ENCRYPTION_KEY='+c.randomBytes(32).toString('hex'))"

# Postgres. Locally: run `npm run pg` and use the URL below.
# In production: Render's External connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# MUST be the public URL in production (include http:// or https://). Tracking pixels,
# click tracking and unsubscribe links are built from this. Also controls whether the
# session cookie is marked Secure — use https:// only when TLS is actually terminating
# in front of the app; http:// on a bare EC2 IP is fine for internal testing.
APP_URL="http://localhost:3000"

# Session signing key (48 random bytes, base64url).
AUTH_SECRET=""
# At-rest encryption for Gmail app passwords. EXACTLY 64 hex characters (32 bytes).
# Changing this makes every stored app password unreadable — members must re-enter them.
ENCRYPTION_KEY=""

# Groq. Comma-separated keys; rotation adds resilience, not throughput (the token
# budget is shared org-wide per model).
GROQ_API_KEYS=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_SEARCH_MODEL="groq/compound-mini"

# Gemini fallback for oversize prompts and Groq rate-limit exhaustion. Optional but
# strongly recommended — without it, large threads fail instead of degrading.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# First admin account, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# Background worker cadence (cron syntax).
WORKER_POLL_CRON="*/5 * * * *"
WORKER_FOLLOWUP_CRON="*/10 * * * *"
