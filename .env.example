# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"
MONGO_URI="REDACTED"
MONGO_DB_NAME="traininglobe_lead_nurturing"

# Authentication & Security
JWT_SECRET="REDACTED"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# Initial Super Admin Account
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="REDACTED"
SUPERADMIN_NAME="Super Admin"

# Zoho Integration (OAuth 2.0)
ZOHO_CLIENT_ID="REDACTED"
ZOHO_CLIENT_SECRET="REDACTED"
ZOHO_REFRESH_TOKEN="REDACTED"
ZOHO_AUTH_URL="https://accounts.zoho.com"
ZOHO_API_DOMAIN="https://www.zohoapis.com"
ZOHO_FROM_EMAIL="admin@example.com"
ZOHO_DRY_RUN="true"

# LLM Configuration (Options: groq, gemini, openai, mock)
LLM_PROVIDER="mock"
LLM_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY="REDACTED"
GEMINI_API_KEY="REDACTED"
OPENAI_API_KEY="REDACTED"

# Automation & Safety Rules
DEFAULT_SEND_TIME="18:00"
TIMEZONE="Asia/Kolkata"
BUSINESS_HOURS_START="9"
BUSINESS_HOURS_END="19"
DAILY_SEND_LIMIT="100"
MAX_FOLLOWUPS="3"

# Legacy Next.js compatibility
APP_URL="http://localhost:3000"
AUTH_SECRET="REDACTED"
ENCRYPTION_KEY="REDACTED"
