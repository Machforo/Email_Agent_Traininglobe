# ==============================================================================
# Traininglobe AI Lead Nurturing - Environment Configuration Template
# Copy to .env and fill in real values. Never commit real credentials.
# ==============================================================================

# Database
MONGO_URI="REDACTED"
MONGO_DB_NAME="traininglobe_lead_nurturing"

# Authentication & Security
JWT_SECRET="REDACTED"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="1440"

# Initial Super Admin Account
SUPERADMIN_EMAIL="admin@traininglobe.com"
SUPERADMIN_PASSWORD="REDACTED"
SUPERADMIN_NAME="Super Admin"

# Zoho Integration (OAuth 2.0)
# Obtain these from https://api-console.zoho.com
ZOHO_CLIENT_ID="REDACTED"
ZOHO_CLIENT_SECRET="REDACTED"
ZOHO_REFRESH_TOKEN="REDACTED"
ZOHO_AUTH_URL="https://accounts.zoho.in"       # Use .com, .in, .eu depending on your Zoho region
ZOHO_API_DOMAIN="https://www.zohoapis.in"     # Use .com, .in, .eu depending on your Zoho region
ZOHO_FROM_EMAIL="outreach@traininglobe.com"
ZOHO_DRY_RUN="true"                           # Set to 'true' for local testing (logs instead of sending)

# LLM Provider Configuration (Options: groq, gemini, openai, mock)
LLM_PROVIDER="mock"
LLM_MODEL="llama-3.3-70b-versatile"
GROQ_API_KEY="REDACTED"
GEMINI_API_KEY="REDACTED"
OPENAI_API_KEY="REDACTED"

# Automation & Safety Rules
DEFAULT_SEND_TIME="18:00"                     # 24-hr format (HH:MM)
TIMEZONE="Asia/Kolkata"
BUSINESS_HOURS_START="9"                      # 9 AM local time
BUSINESS_HOURS_END="19"                       # 7 PM local time
DAILY_SEND_LIMIT="100"
MAX_FOLLOWUPS="3"

# Optional / Legacy Local Postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/postgres"
APP_URL="http://localhost:3000"
AUTH_SECRET="REDACTED"
ENCRYPTION_KEY="REDACTED"
